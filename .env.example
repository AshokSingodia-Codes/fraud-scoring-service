# Environment configuration template
APP_ENV=dev
LOG_LEVEL=INFO
MODEL_VERSION=0.1.0

# Storage & DB
DATABASE_URL=postgresql://user:password@localhost:5432/fraud_db
REDIS_URL=redis://localhost:6379/0

# API Security
ALLOWED_API_KEYS=demo-api-key-12345,change-me-prod-key

# Concurrency & Thread Pool
# Default AnyIO thread limiter is 40 (library default; increasing to 200 had no measured effect under ablation).
ANYIO_MAX_THREADS=40
