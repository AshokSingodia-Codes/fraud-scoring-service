  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Request Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(fraud_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} - {{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Latency p95 (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fraud_request_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Decision Breakdown",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(fraud_decisions_total) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "title": "Fraud Score Distribution",
      "type": "histogram",
      "targets": [
        {
          "expr": "fraud_prediction_score_bucket",
          "legendFormat": "Score"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "title": "Population Stability Index (PSI)",
      "type": "gauge",
      "targets": [
        {
          "expr": "fraud_score_psi",
          "legendFormat": "PSI Drift"
        }
      ]
    }
