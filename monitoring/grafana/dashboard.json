  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Throughput (RPS)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(fraud_requests_total[1m]))",
          "legendFormat": "Total RPS"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "P95 Serving Latency (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fraud_api_request_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Model Health Status",
      "type": "stat",
      "targets": [
        {
          "expr": "fraud_model_health_status",
          "legendFormat": "Health (1=Healthy, 2=Moderate, 3=Critical)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Decision Breakdown",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(fraud_decisions_total) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Streaming Population Stability Index (PSI) Drift",
      "type": "timeseries",
      "targets": [
        {
          "expr": "fraud_feature_psi",
          "legendFormat": "{{feature}} PSI"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Fraud Score Distribution Bucket Heatmap",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(fraud_prediction_score_bucket[1m])) by (le)",
          "legendFormat": "Score le={{le}}"
        }
